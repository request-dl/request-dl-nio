# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Regras globais para qualquer arquivo
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Regras específicas para arquivos Swift
[*.swift]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120